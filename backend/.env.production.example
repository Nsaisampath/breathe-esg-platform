# Production Environment Variables for Render Deployment
# These will be set in Render's dashboard, not committed to Git

# Database (automatically provided by Render when you create PostgreSQL)
DATABASE_URL=postgresql://user:password@host:port/database

# Django settings
SECRET_KEY=your-production-secret-key-here
DEBUG=False
ALLOWED_HOSTS=your-app-name.onrender.com

# Frontend URL (set this to your Vercel frontend URL)
CORS_ALLOWED_ORIGINS=https://your-frontend.vercel.app
